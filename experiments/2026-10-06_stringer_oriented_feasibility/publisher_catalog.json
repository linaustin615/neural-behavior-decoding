py", "size": 773717779, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/18517127", "supplied_md5": "025f3aba5487325df4dffbc62e4b0ba0", "computed_md5": "025f3aba5487325df4dffbc62e4b0ba0", "mimetype": "application/octet-stream"}, {"id": 18517142, "name": "static_sin_rand_TX38_2019_10_17_3.npy", "size": 965175260, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/18517142", "supplied_md5": "dba1234f96f50e790c66c11ea81c006a", "computed_md5": "dba1234f96f50e790c66c11ea81c006a", "mimetype": "application/octet-stream"}, {"id": 18517148, "name": "biased_V2_TX43_2019_10_31_1.npy", "size": 416002229, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/18517148", "supplied_md5": "9bf5e8c0452103c7840db3fe1f7342ef", "computed_md5": "9bf5e8c0452103c7840db3fe1f7342ef", "mimetype": "application/octet-stream"}, {"id": 18517235, "name": "biased_V2_TX34_2019_10_31_1.npy", "size": 720186348, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/18517235", "supplied_md5": "2b6ca50de9ec9f2f4821e9395b163b23", "computed_md5": "2b6ca50de9ec9f2f4821e9395b163b23", "mimetype": "application/octet-stream"}, {"id": 18517247, "name": "biased_V2_TX38_2019_10_30_1.npy", "size": 792216115, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/18517247", "supplied_md5": "8dfe7e142f4728128b0df27f77b8ca0c", "computed_md5": "8dfe7e142f4728128b0df27f77b8ca0c", "mimetype": "application/octet-stream"}], "folder_structure": {}, "authors": [{"id": 4494118, "full_name": "Marius Pachitariu", "first_name": "Marius", "last_name": "Pachitariu", "is_active": true, "url_name": "Marius_Pachitariu", "orcid_id": ""}, {"id": 6843647, "full_name": "Michalis Michaelos", "first_name": "Michalis", "last_name": "Michaelos", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 5183561, "full_name": "Carsen Stringer", "first_name": "Carsen", "last_name": "Stringer", "is_active": true, "url_name": "Carsen_Stringer", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://janelia.figshare.com/articles/dataset/Recordings_of_20_000_neurons_from_V1_in_response_to_oriented_stimuli/8279387", "download_disabled": false, "description": "<p dir=\"ltr\">Recordings from Stringer et al, 2019, now including higher-order visual cortex. The code to reproduce the figures from the paper is here:<a href=\"https://github.com/MouseLand/stringer-et-al-2019\">https://github.com/MouseLand/stringer-et-al-2019</a></p><p dir=\"ltr\">Please use the \"issues\" section from this repository for all communications regarding this dataset.</p><p dir=\"ltr\">Each npy file is one recording of deconvolved fluorescence traces + all its metadata, with the name of the file indicating the stimulus set.If you use these data in a paper, please cite the original research paper as well as this dataset using the figshare doi.</p><p dir=\"ltr\">Each stimulus set is a single image/movie, with each trial rotating that stimulus by a random angle between 0 and 360. Unless otherwise specified, the stimuli cover 90 degrees of visual field at 0.05 cycles/degree and are shown for 750ms, with ~1000ms in-between. This ISI is fixed and determined by the recording rate which changes slightly from dataset to dataset.</p><p dir=\"ltr\">1) gratings_static: square static gratings.</p><p dir=\"ltr\">2) minnie: complex stimulus (cartoon mouse head).</p><p dir=\"ltr\">3) gratings_short: 100ms presentation time</p><p dir=\"ltr\">4) local: localized to neural receptive fields (30 deg)</p><p dir=\"ltr\">5) static_biased: rotation drawn randomly from interval [43 47] degrees</p><p dir=\"ltr\">The next stimulus sets are all drifting at 2Hz:</p><p dir=\"ltr\">6) gratings_drifting: drifting gratings</p><p dir=\"ltr\">7) gratings_low_contrast: 1/20 the full contrast</p><p dir=\"ltr\">8) gratings_noisy: low contrast and per-frame independent noise</p><p dir=\"ltr\">Added in revision</p><p dir=\"ltr\">9) sinusoidal gratings with randomized phases</p><p dir=\"ltr\">10) biased_V2: like #5 but in higher-order areas lateral to V1.</p><p dir=\"ltr\"><br><br>Note that the stimuli are triggered on the microscope frames, so a neuron is always sampled at the same offset from stimulus start times.</p>", "funding": "HHMI Janelia Research Campus", "funding_list": [{"id": 14917631, "title": "HHMI Janelia Research Campus", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 3, "status": "public", "size": 35094302294, "created_date": "2019-11-05T16:56:54Z", "modified_date": "2023-09-05T19:17:31Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 10, "name": "CC BY-NC 4.0", "url": "https://creativecommons.org/licenses/by-nc/4.0/"}, "tags": ["gratings", "calcium imaging", "neural recordings", "visual cortex", "Neuroscience"], "keywords": ["gratings", "calcium imaging", "neural recordings", "visual cortex", "Neuroscience"], "categories": [{"id": 24748, "title": "Neurosciences not elsewhere classified", "parent_id": 24724, "path": "/24457/24724/24748", "source_id": "320999", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Pachitariu, Marius; Michaelos, Michalis; Stringer, Carsen (2019). Recordings of ~20,000 neurons from V1 in response to oriented stimuli. Janelia Research Campus. Dataset. https://doi.org/10.25378/janelia.8279387.v3", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": "file", "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 8279387, "title": "Recordings of ~20,000 neurons from V1 in response to oriented stimuli", "doi": "10.25378/janelia.8279387.v3", "handle": "", "url": "https://api.figshare.com/v2/articles/8279387", "published_date": "2019-11-05T16:56:54Z", "thumb": "https://s3-eu-west-1.amazonaws.com/ppreviews-janelia-121192874762290/18517112/thumb.png", "defined_type"